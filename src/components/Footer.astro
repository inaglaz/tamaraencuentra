---
interface Props {
  marginTop?: string;
}

const { marginTop = 'mt-12' } = Astro.props;
---

<footer class:list={['bg-stone-dark text-primary-light py-20 px-6 rounded-t-[3rem]', marginTop]}>
  <div class="max-w-[1280px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
    <div class="space-y-6">
      <div class="flex items-center gap-2">
        <img src="/assets/logo.png" alt="Tamara Encuentra" class="h-12 w-auto object-contain" />
      </div>
      <p class="text-white/60 text-sm leading-relaxed max-w-xs font-light">
        Tu santuario de belleza. Especialistas en realzar tu naturalidad con tecnología y experiencia.
      </p>
      <div class="flex gap-4">
        <a
          class="w-10 h-10 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center transition-colors"
          href="https://www.instagram.com/tamaraencuentra/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="material-symbols-outlined text-sm">public</span>
        </a>
        <a
          class="w-10 h-10 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center transition-colors"
          href="https://www.instagram.com/tamaraencuentra/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="material-symbols-outlined text-sm">videocam</span>
        </a>
      </div>
    </div>
    <div class="space-y-6">
      <h4 class="text-white font-medium tracking-widest uppercase text-xs">Menu</h4>
      <ul class="space-y-3 text-sm font-light text-white/70">
        <li><a class="hover:text-primary transition-colors" href="/servicios.html">Servicios</a></li>
        <li><a class="hover:text-primary transition-colors" href="/formaciones.html">Formación</a></li>
        <li><a class="hover:text-primary transition-colors" href="/nosotras.html">Nuestro equipo</a></li>
        <li><a class="hover:text-primary transition-colors" href="#">Tarjetas Regalo</a></li>
      </ul>
    </div>
    <div class="space-y-6">
      <h4 class="text-white font-medium tracking-widest uppercase text-xs">Contacto</h4>
      <ul class="space-y-4 text-sm font-light text-white/70">
        <li class="flex items-start gap-3">
          <span class="material-symbols-outlined text-primary mt-0.5 text-lg">location_on</span>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Tamara+Encuentra+C.+Entamador+10+Dos+Hermanas"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-white transition-colors"
          >
            C. Entamador, 10, Local 11,<br />41701 Dos Hermanas, Sevilla
          </a>
        </li>
        <li class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary text-lg">call</span>
          <a href="tel:+34647663121" class="hover:text-white transition-colors">647 66 31 21</a>
        </li>
        <li class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary text-lg">mail</span>
          <a href="mailto:tamaraencuentra@gmail.com" class="hover:text-white transition-colors">
            tamaraencuentra@gmail.com
          </a>
        </li>
      </ul>
    </div>
    <div class="space-y-6">
      <h4 class="text-white font-medium tracking-widest uppercase text-xs">Encuéntranos</h4>
      <a
        href="https://www.google.com/maps/search/?api=1&query=Tamara+Encuentra+C.+Entamador+10+Dos+Hermanas"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full aspect-video rounded-2xl bg-[#3a3630] overflow-hidden grayscale hover:grayscale-0 transition-all duration-500 opacity-80 hover:opacity-100 border border-white/10"
      >
        <div
          class="w-full h-full bg-cover bg-center"
          style="background-image: url('/assets/mapa-doshermanas.webp');"
        >
        </div>
      </a>
    </div>
  </div>
  <div
    class="max-w-[1280px] mx-auto mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-white/40 font-light"
  >
    <p>© 2026 Tamara Encuentra. Todos los derechos reservados.</p>
    <div class="flex gap-6">
      <a class="hover:text-white transition-colors" href="/aviso-legal.html#legal">Aviso Legal</a>
      <a class="hover:text-white transition-colors" href="/aviso-legal.html#privacidad">Privacidad</a>
      <a class="hover:text-white transition-colors" href="/aviso-legal.html#cookies">Cookies</a>
    </div>
  </div>
</footer>
