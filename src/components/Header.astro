---
interface Props {
  currentPage?: 'inicio' | 'servicios' | 'formaciones' | 'nosotras' | null;
}

const { currentPage = null } = Astro.props;

const desktopLinks = [
  { id: 'servicios', label: 'Servicios', href: '/servicios.html' },
  { id: 'formaciones', label: 'Formaciones', href: '/formaciones.html' },
  { id: 'nosotras', label: 'Nuestro equipo', href: '/nosotras.html' },
] as const;

const booksyUrl =
  'https://booksy.com/es-es/16351_tamara-encuentra_cejas-y-pestanas_29946_dos-hermanas#ba_s=seo';
---

<nav
  class="fixed top-0 left-0 right-0 z-50 w-full glass-nav border-b border-primary/10 transition-all duration-300"
>
  <div class="max-w-[1280px] mx-auto px-6 h-20 flex items-center justify-between relative">
    <a
      class="flex items-center group absolute left-1/2 -translate-x-1/2 md:static md:translate-x-0 z-50"
      href="/"
    >
      <img
        src="/assets/logo.png"
        alt="Tamara Encuentra"
        class="h-12 lg:h-14 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
      />
    </a>
    <div
      class="hidden md:flex items-center gap-10 absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2"
    >
      {
        desktopLinks.map((link) =>
          currentPage === link.id ? (
            <a class="text-primary text-sm font-semibold relative" href={link.href}>
              {link.label}
              <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-primary rounded-full" />
            </a>
          ) : (
            <a
              class="text-text-main/70 dark:text-white/80 text-sm font-medium hover:text-primary transition-colors"
              href={link.href}
            >
              {link.label}
            </a>
          )
        )
      }
    </div>
    <div class="flex items-center gap-4 hidden sm:flex">
      <a
        class="cursor-pointer flex items-center justify-center rounded-full h-11 px-6 bg-text-main text-white hover:bg-primary transition-all duration-300 text-sm font-medium shadow-soft app-hover"
        href={booksyUrl}
        rel="noopener noreferrer"
        target="_blank"
      >
        <span>Reserva en Booksy</span>
      </a>
    </div>
  </div>
</nav>

<nav
  class="md:hidden fixed bottom-0 left-0 w-full bg-white/95 backdrop-blur-xl border-t border-gray-100 z-50 pb-safe shadow-[0_-5px_20px_rgba(0,0,0,0.03)]"
>
  <div class="grid grid-cols-5 h-20 items-center justify-items-center px-2">
    <a
      class:list={[
        'flex flex-col items-center gap-1',
        currentPage === 'inicio' ? 'text-primary' : 'text-gray-400',
      ]}
      href="/"
    >
      <span class="material-symbols-outlined text-[24px]">home</span>
      <span class="text-[10px] font-medium">Inicio</span>
    </a>
    <a
      class:list={[
        'flex flex-col items-center gap-1',
        currentPage === 'servicios' ? 'text-primary' : 'text-gray-400',
      ]}
      href="/servicios.html"
    >
      <span class="material-symbols-outlined text-[24px]">spa</span>
      <span class="text-[10px] font-medium">Servicios</span>
    </a>
    <div class="relative -top-5">
      <a
        class="flex items-center justify-center w-14 h-14 bg-text-main text-white rounded-full shadow-lg border-4 border-white app-hover"
        href={booksyUrl}
        rel="noopener noreferrer"
        target="_blank"
      >
        <span class="material-symbols-outlined text-2xl">calendar_month</span>
      </a>
    </div>
    <a
      class:list={[
        'flex flex-col items-center gap-1',
        currentPage === 'formaciones' ? 'text-primary' : 'text-gray-400',
      ]}
      href="/formaciones.html"
    >
      <span class="material-symbols-outlined text-[24px]">school</span>
      <span class="text-[10px] font-medium">Cursos</span>
    </a>
    <a
      class:list={[
        'flex flex-col items-center gap-1',
        currentPage === 'nosotras' ? 'text-primary' : 'text-gray-400',
      ]}
      href="/nosotras.html"
    >
      <span class="material-symbols-outlined text-[24px]">group</span>
      <span class="text-[10px] font-medium">Equipo</span>
    </a>
  </div>
</nav>
