---
interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = '',
  bodyClass = 'bg-background-light dark:bg-background-dark text-text-main overflow-x-hidden antialiased selection:bg-primary/20 pb-20 md:pb-0',
} = Astro.props;
---

<!DOCTYPE html>
<html class="light" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800&family=Caveat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script is:inline id="tailwind-config">
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              primary: '#cfaa68',
              'primary-light': '#f0e6d2',
              'background-light': '#fcfbf9',
              'background-dark': '#1c1a16',
              'accent-sage': '#aeb5a3',
              'accent-blush': '#ebdcd6',
              'stone-dark': '#36322d',
              'text-main': '#2b261f',
            },
            fontFamily: {
              sans: ['Poppins', 'sans-serif'],
              display: ['Poppins', 'sans-serif'],
              body: ['Poppins', 'sans-serif'],
              serif: ['Playfair Display', 'serif'],
              handwriting: ['Caveat', 'cursive'],
            },
            borderRadius: {
              DEFAULT: '1rem',
              lg: '1rem',
              xl: '1.5rem',
              '2xl': '2rem',
              '3xl': '2.5rem',
              '4xl': '3.5rem',
              full: '9999px',
            },
            boxShadow: {
              soft: '0 10px 40px -10px rgba(0,0,0,0.08)',
              glass: '0 8px 32px 0 rgba(31, 38, 135, 0.07)',
              float: '0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)',
            },
            animation: {
              'pulse-sage': 'pulseSage 3s infinite',
              'draw-underline': 'drawUnderline 1.5s ease-out forwards',
              'float-slow': 'float 6s ease-in-out infinite',
              'float-delayed': 'float 6s ease-in-out 3s infinite',
              scribble: 'scribble 2s ease-in-out infinite alternate',
              'fade-in-up': 'fadeInUp 0.8s ease-out forwards',
              'spin-slow': 'spin 20s linear infinite',
            },
            keyframes: {
              pulseSage: {
                '0%, 100%': {
                  boxShadow: '0 0 0 0 rgba(174, 181, 163, 0)',
                  borderColor: 'rgba(174, 181, 163, 0.3)',
                  backgroundColor: 'rgba(174, 181, 163, 0.05)',
                },
                '50%': {
                  boxShadow: '0 0 15px 0 rgba(174, 181, 163, 0.2)',
                  borderColor: '#aeb5a3',
                  backgroundColor: 'rgba(174, 181, 163, 0.15)',
                },
              },
              drawUnderline: {
                '0%': { width: '0%' },
                '100%': { width: '100%' },
              },
              float: {
                '0%, 100%': { transform: 'translateY(0)' },
                '50%': { transform: 'translateY(-10px)' },
              },
              scribble: {
                '0%': { transform: 'skew(1deg)' },
                '100%': { transform: 'skew(-1deg)' },
              },
              fadeInUp: {
                '0%': { opacity: '0', transform: 'translateY(20px)' },
                '100%': { opacity: '1', transform: 'translateY(0)' },
              },
            },
          },
        },
      };
    </script>
    <style is:global>
      body {
        font-family: 'Poppins', sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .glass-nav {
        background: rgba(252, 251, 249, 0.8);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
      }
      .glass-card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.5);
      }
      .glass-pill {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      }
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
      .text-gradient {
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        background-image: linear-gradient(to right, #2b261f, #cfaa68);
      }
      .app-hover {
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .app-hover:hover {
        transform: scale(1.03);
      }
      .pb-safe {
        padding-bottom: env(safe-area-inset-bottom, 20px);
      }
      @media (max-width: 768px) {
        .glass-nav {
          background: transparent !important;
          backdrop-filter: none !important;
          -webkit-backdrop-filter: none !important;
          border-bottom: none !important;
        }
      }
    </style>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
