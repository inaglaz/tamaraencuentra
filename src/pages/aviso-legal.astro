---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Tamara Encuentra - Aviso Legal">
<Fragment slot="head">
  <style is:global>
    body {
      font-family: 'Poppins', sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .glass-nav {
      background: rgba(252, 251, 249, 0.8);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
    .glass-card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }
    .glass-pill {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .text-gradient {
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        background-image: linear-gradient(to right, #2b261f, #cfaa68);
    }.app-hover {
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .app-hover:hover {
        transform: scale(1.03);
    }.pb-safe {
        padding-bottom: env(safe-area-inset-bottom, 20px);
    }
    .underline-brush {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 0.5em;
        background-color: rgba(207, 170, 104, 0.3);
        z-index: -1;
        transform: skew(-10deg) rotate(-1deg);
        border-radius: 4px;
    }
    .marker-highlight {
        position: relative;
        z-index: 1;
        display: inline-block;
    }
    .marker-highlight::before {
        content: '';
        position: absolute;
        bottom: 2px;
        left: -2px;
        right: -2px;
        height: 12px;
        background-color: #f0e6d2;
        z-index: -1;
        transform: rotate(-1deg);
        border-radius: 4px;
        opacity: 0.7;
    }
    .hand-drawn-arrow {
        position: absolute;
        pointer-events: none;
        z-index: 10;
    }
    @media (max-width: 768px) {
        .mobile-hero-container {
            min-height: 100svh;height: 100svh;
            display: flex;
            flex-direction: column;
            justify-content: center;padding-bottom: calc(4rem + env(safe-area-inset-bottom, 20px));padding-top: 5rem;
        }.glass-nav {
            background: transparent !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border-bottom: none !important;
        }
        .glass-nav h1, .glass-nav .material-symbols-outlined {}
    }
    @media (min-width: 769px) {
        .hero-bg-mobile, .hero-overlay-mobile {
            display: none;
        }
    }
  </style>
</Fragment>

  <Header />

<main class="pt-20 bg-background-light">
<div class="max-w-4xl mx-auto px-6 py-24 text-gray-600 font-light leading-relaxed">

    <h1 class="text-3xl md:text-4xl font-light text-text-main mb-12">Aviso Legal y Políticas</h1>

    <section id="legal" class="mb-16 scroll-mt-32">
        <h2 class="text-2xl font-bold text-primary mb-6">1. Datos Identificativos</h2>
        <p class="mb-4">En cumplimiento con el artículo 10 de la Ley 34/2002 (LSSI-CE), se informa que la titular del sitio web es:</p>
        <ul class="list-disc pl-6 mb-4 space-y-2">
            <li><strong>Titular:</strong> Tamara Encuentra Arocha</li>
            <li><strong>NIF:</strong> 49030640E</li>
            <li><strong>Domicilio:</strong> C. Entamador, 10, Local 11, 41701 Dos Hermanas, Sevilla</li>
            <li><strong>Contacto:</strong> tamaraencuentra@gmail.com | 647 66 31 21</li>
        </ul>
    </section>

    <section id="privacidad" class="mb-16 scroll-mt-32">
        <h2 class="text-2xl font-bold text-primary mb-6">2. Política de Privacidad y Gestión de Citas</h2>
        <p class="mb-4"><strong>Inexistencia de formularios de recogida de datos:</strong> Este sitio web NO dispone de formularios de contacto ni bases de datos propias para el registro de usuarios.</p>

        <p class="mb-4"><strong>Gestión de Citas (Booksy):</strong> La gestión de citas y reservas se realiza íntegramente a través de la plataforma externa <strong>Booksy</strong>. Al hacer clic en los botones de "Reservar", el usuario será redirigido a dicha plataforma. El tratamiento de los datos personales (nombre, teléfono, email) necesarios para la reserva se rige exclusivamente por la <a href="https://booksy.com/biz/es-es/privacy-policy" target="_blank" class="text-primary underline">Política de Privacidad de Booksy</a>, actuando Tamara Encuentra únicamente como usuario profesional de dicha herramienta.</p>

        <p class="mb-4"><strong>Comunicaciones por WhatsApp:</strong> Al pulsar el botón de WhatsApp, el usuario acepta contactar directamente a través de dicha aplicación. Los datos (número de teléfono y conversación) serán tratados únicamente con la finalidad de atender la consulta, amparados en el interés legítimo y la relación pre-contractual.</p>
    </section>

    <section class="mb-16">
        <h2 class="text-2xl font-bold text-primary mb-6">3. Propiedad Intelectual</h2>
        <p>Todos los contenidos de esta web (textos, imágenes, logotipos y diseño) son propiedad intelectual de Tamara Encuentra Arocha. Queda prohibida su reproducción o uso comercial sin autorización expresa.</p>
    </section>

    <section id="cookies" class="mb-16 scroll-mt-32">
        <h2 class="text-2xl font-bold text-primary mb-6">4. Política de Cookies</h2>
        <p class="mb-4">Este sitio web utiliza únicamente cookies técnicas imprescindibles para el correcto funcionamiento de la página. No utilizamos cookies publicitarias ni de rastreo de terceros que requieran consentimiento explícito según la normativa vigente (AEPD).</p>
        <p>Al ser una web informativa que redirige servicios a terceros (Booksy/Google Maps), la navegación se considera segura y privada.</p>
    </section>

    <section class="mb-12">
        <h2 class="text-2xl font-bold text-primary mb-6">5. Legislación y Jurisdicción</h2>
        <p>Para la resolución de cualquier controversia, las partes se someten a los Juzgados y Tribunales de Sevilla (España).</p>
    </section>

</div>
</main>

  <Footer />

<!-- Video Modal -->
<div id="video-modal" class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-xl flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
    <button id="close-modal" class="absolute top-6 right-6 text-white/70 hover:text-white z-[110] transition-colors">
        <span class="material-symbols-outlined text-4xl">close</span>
    </button>
    <div class="relative w-full max-w-[450px] aspect-[9/16] bg-black shadow-2xl overflow-hidden md:rounded-2xl mx-4">
        <video id="modal-video" class="w-full h-full object-cover" playsinline>
            <source src="/assets/video-hero.mp4" type="video/mp4">
        </video>
        <div class="absolute inset-0 flex flex-col justify-between p-6 bg-gradient-to-b from-black/40 via-transparent to-black/60 pointer-events-none">
            <div class="flex justify-end">
                <button id="toggle-volume" class="pointer-events-auto w-10 h-10 rounded-full bg-black/20 backdrop-blur flex items-center justify-center text-white hover:bg-black/40 transition-all">
                    <span class="material-symbols-outlined" id="volume-icon">volume_up</span>
                </button>
            </div>
            <div class="w-full space-y-4 pointer-events-auto">
                <div class="w-full h-1.5 bg-white/20 rounded-full overflow-hidden cursor-pointer group relative" id="progress-container">
                    <div id="progress-bar" class="absolute left-0 top-0 h-full bg-primary w-0"></div>
                </div>
                <div class="flex items-center justify-between text-white/80 text-xs font-mono">
                    <span id="current-time">00:00</span>
                    <span id="total-duration">00:00</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('services-container');
    const scrollLeft = document.getElementById('scroll-left');
    const scrollRight = document.getElementById('scroll-right');

    if (container && scrollLeft && scrollRight) {
      const scrollAmount = 300;

      scrollLeft.addEventListener('click', () => {
        container.scrollBy({
          left: -scrollAmount,
          behavior: 'smooth'
        });
      });

      scrollRight.addEventListener('click', () => {
        container.scrollBy({
          left: scrollAmount,
          behavior: 'smooth'
        });
      });
    }

    // Video Modal Logic
    const openModalBtn = document.getElementById('open-video-modal');
    const videoModal = document.getElementById('video-modal');
    const closeModalBtn = document.getElementById('close-modal');
    const modalVideo = document.getElementById('modal-video');
    const toggleVolumeBtn = document.getElementById('toggle-volume');
    const volumeIcon = document.getElementById('volume-icon');
    const progressBar = document.getElementById('progress-bar');
    const progressContainer = document.getElementById('progress-container');
    const currentTimeEl = document.getElementById('current-time');
    const totalDurationEl = document.getElementById('total-duration');

    const formatTime = (time) => {
      const minutes = Math.floor(time / 60);
      const seconds = Math.floor(time % 60);
      return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
    };

    const openModal = () => {
      videoModal.classList.remove('opacity-0', 'pointer-events-none');
      modalVideo.play();
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      videoModal.classList.add('opacity-0', 'pointer-events-none');
      modalVideo.pause();
      modalVideo.currentTime = 0;
      document.body.style.overflow = '';
    };

    if (openModalBtn && videoModal && closeModalBtn && modalVideo) {
      openModalBtn.addEventListener('click', openModal);
      closeModalBtn.addEventListener('click', closeModal);
      videoModal.addEventListener('click', (e) => {
        if (e.target === videoModal) closeModal();
      });

      toggleVolumeBtn.addEventListener('click', () => {
        modalVideo.muted = !modalVideo.muted;
        volumeIcon.textContent = modalVideo.muted ? 'volume_off' : 'volume_up';
      });

      modalVideo.addEventListener('timeupdate', () => {
        const progress = (modalVideo.currentTime / modalVideo.duration) * 100;
        progressBar.style.width = `${progress}%`;
        currentTimeEl.textContent = formatTime(modalVideo.currentTime);
      });

      modalVideo.addEventListener('loadedmetadata', () => {
        totalDurationEl.textContent = formatTime(modalVideo.duration);
      });

      progressContainer.addEventListener('click', (e) => {
        const rect = progressContainer.getBoundingClientRect();
        const pos = (e.clientX - rect.left) / rect.width;
        modalVideo.currentTime = pos * modalVideo.duration;
      });
    }
  });
</script>

</Layout>
