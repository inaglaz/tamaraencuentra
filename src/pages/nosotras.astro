---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Tamara Encuentra - Equipo & Fundadora">
<Fragment slot="head">
  <style is:global>
    body {
      font-family: 'Poppins', sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .glass-nav {
      background: rgba(252, 251, 249, 0.8);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
    .glass-card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }
    .glass-pill {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .text-gradient {
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        background-image: linear-gradient(to right, #2b261f, #cfaa68);
    }.app-hover {
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .app-hover:hover {
        transform: scale(1.03);
    }.pb-safe {
        padding-bottom: env(safe-area-inset-bottom, 20px);
    }
    .underline-brush {
        position: absolute;
        bottom: 0.1em;
        left: 0;
        height: 0.4em;
        background-color: rgba(207, 170, 104, 0.4);
        z-index: -1;
        transform: skew(-10deg) rotate(-1deg);
        border-radius: 4px;
        width: 100%;
    }
    .marker-highlight {
        position: relative;
        z-index: 1;
        display: inline-block;
    }
    .marker-highlight::before {
        content: '';
        position: absolute;
        bottom: 2px;
        left: -2px;
        right: -2px;
        height: 12px;
        background-color: #f0e6d2;
        z-index: -1;
        transform: rotate(-1deg);
        border-radius: 4px;
        opacity: 0.7;
    }
    .polaroid {
        background: white;
        padding: 1rem;
        padding-bottom: 3rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        transition: all 0.3s ease;
    }
    .polaroid:hover {
        transform: scale(1.02) rotate(0deg) !important;
        z-index: 10;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
    .snap-mandatory-x {
        scroll-snap-type: x mandatory;
    }
    .snap-center {
        scroll-snap-align: center;
    }
    @media (max-width: 768px) {
        .mobile-hero-container {
            min-height: 85svh;
            height: auto;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding-bottom: calc(4rem + env(safe-area-inset-bottom, 20px));
            padding-top: 7rem;
        }.glass-nav {
            background: transparent !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border-bottom: none !important;
        }
    }
    @media (min-width: 769px) {
        .hero-bg-mobile, .hero-overlay-mobile {
            display: none;
        }
    }
  </style>
</Fragment>

  <Header currentPage="nosotras" />

<section class="relative min-h-[85vh] md:min-h-screen pt-20 pb-20 px-6 md:pt-40 md:pb-24 lg:px-20 overflow-hidden flex flex-col items-center justify-center mobile-hero-container bg-[#f7f5f2]">
<div class="max-w-[1000px] mx-auto w-full relative z-10 text-center flex flex-col items-center">
<div class="inline-flex items-center px-4 py-2 bg-white/60 backdrop-blur border border-primary/20 rounded-full text-[10px] md:text-xs font-semibold tracking-wider uppercase text-primary shadow-sm w-fit animate-pulse-sage transition-all duration-500 mb-6">
<span class="w-2 h-2 rounded-full bg-primary mr-2 animate-pulse"></span>
            Equipo Full Consistency
        </div>
<h1 class="text-text-main dark:text-white text-[2.8rem] leading-[1.15] sm:text-6xl lg:text-[5rem] font-medium md:leading-[1.1] tracking-tight relative drop-shadow-md md:drop-shadow-none mb-6">
<span class="block">Las <span class="text-primary italic font-light relative inline-block">manos<span class="underline-brush animate-draw-underline"></span></span> detrás</span>
<span class="text-primary italic font-light relative inline-block">
<span class="relative z-10">de tu belleza</span>
<span class="underline-brush animate-draw-underline"></span>
</span>
</h1>
<p class="text-text-main/80 dark:text-white text-base md:text-xl leading-relaxed max-w-2xl font-light mx-auto mb-10">
            Un equipo de profesionales apasionadas, liderado por Tamara, comprometidas con realzar tu esencia natural.
        </p>
<div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
<button class="flex w-full sm:w-auto cursor-pointer items-center justify-center rounded-full h-14 px-8 bg-text-main hover:bg-black text-white text-base font-medium transition-all shadow-soft app-hover">
<span>Conoce al equipo</span>
</button>
<a class="flex w-full sm:w-auto cursor-pointer items-center justify-center rounded-full h-14 px-8 bg-white/80 border border-gray-200 hover:border-primary text-text-main text-base font-medium transition-all shadow-sm app-hover backdrop-blur-sm" href="https://booksy.com/es-es/16351_tamara-encuentra_cejas-y-pestanas_29946_dos-hermanas#ba_s=seo" rel="noopener noreferrer" target="_blank">
<span>Reserva tu cita</span>
</a>
</div>
<svg class="absolute top-0 right-0 md:-right-10 w-24 h-24 text-primary/30 rotate-12 hidden md:block animate-float-slow" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 100 100">
<path d="M50,10 A40,40 0 1,1 49,10" stroke-dasharray="5 5"></path>
<path d="M50,30 L65,45 L50,60" transform="rotate(-45 50 50)"></path>
</svg>
