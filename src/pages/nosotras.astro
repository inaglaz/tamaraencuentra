<script is:inline>
    // Script to activate color on scroll for mobile devices
    document.addEventListener("DOMContentLoaded", function() {
        // Ejecutar solo en móviles/tablets (< 1024px) para no interferir con el hover de desktop
        if (window.innerWidth < 1024) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    // Cuando la imagen entra en el 50% central de la pantalla
                    if (entry.isIntersecting) {
                        entry.target.classList.remove('grayscale'); // Se pone a color
                    } else {
                        entry.target.classList.add('grayscale'); // Vuelve a B/N al salir
                    }
                });
            }, {
                root: null,
                rootMargin: '-25% 0px -25% 0px', // Márgenes para definir la zona activa central
                threshold: 0.1
            });

            // Observar todas las imágenes con la clase marcador
            document.querySelectorAll('.js-scroll-color').forEach(img => observer.observe(img));
        }
    });
</script>

